# Copiá este archivo como .env y completá las keys que tengas.
# Un juego sin key funciona en modo ejemplo (datos inventados, sin imágenes).

PORT=3000

# Clash Royale: https://developer.clashroyale.com
CR_API_KEY=
# Clash of Clans: https://developer.clashofclans.com
COC_API_KEY=
# Brawl Stars: https://developer.brawlstars.com
BS_API_KEY=

# Opcional: cambiar la dirección base de cada API (por ejemplo si usás un proxy con IP fija)
# CR_BASE_URL=https://api.clashroyale.com/v1
# COC_BASE_URL=https://api.clashofclans.com/v1
# BS_BASE_URL=https://api.brawlstars.com/v1
